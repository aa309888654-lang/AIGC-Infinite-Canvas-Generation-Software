{
  "name": "xiaotian-canvas",
  "private": true,
  "version": "2.7.9",
  "displayVersion": "v2.7.9",
  "description": "AI-driven professional creative studio for canvas workflows, video editing, voiceover, and music generation.",
  "author": "AICG Studio Team",
  "main": "electron-main.cjs",
  "type": "commonjs",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/clean-dist.cjs && vite build && node scripts/check-poster-agent-client-boundary.cjs --dist && node scripts/cleanup-sw.cjs",
    "prebuild": "npm run check:poster-sources && npm run check:poster-agent-boundary",
    "build:prod": "npm run build && node scripts/obfuscate.cjs",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:build:dir": "npm run build && electron-builder --win --x64 --dir",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:exe": "node build-exe.js",
    "build:export": "node build-and-export.js",
    "export:exe": "node export-exe.js",
    "export:now": "node export-now.js",
    "export:douyin": "node export-to-douyin-version.js",
    "export:douyin:quick": "node quick-export-douyin.js",
    "export:desktop": "node export-to-desktop.js",
    "export:jieru": "node export-to-desktop-jieru.js",
    "export:e-folder": "node export-to-e-folder.js",
    "export:e-v2": "node export-to-e-folder-v2.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --maxWorkers=2 --testPathIgnorePatterns='e2e'",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "security:audit": "npm audit --omit=dev --registry=https://registry.npmjs.org/",
    "docs": "typedoc",
    "docs:jsdoc": "jsdoc -c jsdoc.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit",
    "check:poster-sources": "node scripts/check-poster-source-shadowing.cjs",
    "check:poster-agent-boundary": "node scripts/check-poster-agent-client-boundary.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hookform/resolvers": "^3.9.0",
    "@huggingface/transformers": "^4.2.0",
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.94",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@types/three": "^0.185.1",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.7.7",
    "browser-id3-writer": "^6.3.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.2",
    "esbuild": "^0.28.0",
    "fabric": "^7.2.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "immer": "^11.1.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.0",
    "pixi.js": "^8.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.53.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "rembg-webgpu": "^0.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.11",
    "tone": "^15.1.22",
    "wavesurfer.js": "^7.12.5",
    "web-vitals": "^5.2.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.3.1",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^10.3.1",
    "@storybook/react-vite": "^10.3.1",
    "@storybook/test": "^8.6.15",
    "@storybook/testing-library": "^0.2.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.4.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdoc": "^4.0.0",
    "lint-staged": "^16.4.0",
    "onnxruntime-web": "1.21.0",
    "postcss": "^8.4.47",
    "prettier": "^3.2.0",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^3.4.14",
    "terser": "^5.46.1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.14",
    "vite-plugin-compression": "^0.5.1"
  }
}
