# OmniRoute 网关配置
# 如果不使用 OmniRoute，这些变量可以留空

# OmniRoute 服务地址（默认：http://localhost:20128）
VITE_OMNIROUTE_URL=

# 主站 API 地址
# 开源版部署时填写实际域名，例如：
# VITE_API_BASE_URL=https://your-domain.com/api/v1
VITE_API_BASE_URL=

# 静态资源基础地址
# 开源版留空，使用本地后端
VITE_STATIC_BASE_URL=

# 开源本地模式：true 时免登录、全功能解锁（默认开启）
VITE_LOCAL_MODE=true

# ============================================
# 重要安全说明
# ============================================
# 所有 AI 模型的 API Key 由后端统一管理，前端不暴露。
# 请在后端 .env 文件中配置对应的环境变量。
#
# 后端可配置的变量（backend/.env）：
# - DOUBAO_API_KEY / DOUBAO_BASE_URL
# - MINIMAX_API_KEY / MINIMAX_BASE_URL
# - VIDU_API_KEY
# - JIMENG_API_KEY
# - DEEPSEEK_API_KEY
# - QWEN_API_KEY / DASHSCOPE_API_KEY
# - KIMI_API_KEY
# - HAILUO_API_KEY
# - ZHIPU_API_KEY / GLM4_PLUS_API_KEY
# - STABILITY_API_KEY
# - VOLCANO_ARK_API_KEY
# - NVIDIA_NIM_API_KEY
# - AISZ_API_KEY
# - APIPATHS_API_KEY
# ============================================
