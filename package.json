    "@types/jsonwebtoken": "^9.0.5",
    "@types/minio": "^7.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.19",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.185.1",
