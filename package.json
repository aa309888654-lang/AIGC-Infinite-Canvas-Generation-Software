{
  "name": "xiaotian-canvas",
  "private": true,
  "version": "2.8.0",
  "displayVersion": "v2.8.0",
  "description": "小天画布（AICGXT）：本地优先的 AI 创意工作台（前后端一体化单包）",
  "type": "commonjs",
  "main": "server/dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev:server": "cd server && tsx watch --ignore prisma --ignore dist src/index.ts",
    "dev:web": "cd web && vite --host",
    "dev": "npm run dev:server",
    "build:server": "cd server && tsc && node -e \"const fs=require('fs'),p='dist/services/promptSmart3/providers.json',s='src/services/promptSmart3/providers.json';if(fs.existsSync(s)){fs.mkdirSync(require('path').dirname(p),{recursive:true});fs.copyFileSync(s,p);console.log('Copied providers.json')}\"",
    "build:web": "cd web && node scripts/clean-dist.cjs && vite build && node scripts/check-poster-agent-client-boundary.cjs --dist && node scripts/cleanup-sw.cjs",
    "build": "npm run build:server && npm run build:web",
    "build:prod": "npm run build && cd server && node scripts/obfuscate.js && cd ../web && node scripts/obfuscate.cjs",
    "start": "cd server && node dist/index.js",
    "preview": "cd web && vite preview",
    "prebuild:web": "node web/scripts/check-poster-source-shadowing.cjs && node web/scripts/check-poster-agent-client-boundary.cjs",
    "test:server": "cd server && vitest run",
    "test:web": "cd web && jest",
    "test": "npm run test:server",
    "test:watch:server": "cd server && vitest",
    "test:coverage:server": "cd server && vitest run --coverage",
    "test:e2e": "npm run build:web && cd web && playwright test",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "cd server && prisma migrate dev",
    "prisma:studio": "cd server && prisma studio",
    "init:providers": "cd server && tsx scripts/init-provider-config.ts",
    "predeploy": "cd server && tsx scripts/predeploy-check.ts",
    "backup:providers": "cd server && tsx scripts/backup-providers.ts backup",
    "restore:providers": "cd server && tsx scripts/backup-providers.ts restore",
    "list:providers": "cd server && tsx scripts/backup-providers.ts list",
    "typecheck:server": "cd server && tsc --noEmit",
    "typecheck:web": "cd web && tsc --noEmit",
    "typecheck": "npm run typecheck:server",
    "typecheck:strict": "cd server && tsc --noEmit -p tsconfig.strict.json",
    "lint:server": "cd server && eslint \"src/**/*.{ts,js}\"",
    "lint:web": "cd web && eslint src --ext .ts,.tsx",
    "lint:fix:server": "cd server && eslint \"src/**/*.{ts,js}\" --fix",
    "lint:fix:web": "cd web && eslint src --ext .ts,.tsx --fix",
    "format:web": "cd web && prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "security:audit": "npm audit --omit=dev --registry=https://registry.npmjs.org/",
    "electron:dev": "cd web && electron .",
    "electron:build": "npm run build:web && cd web && electron-builder --win --x64",
    "tauri": "cd web && tauri",
    "tauri:dev": "cd web && tauri dev",
    "tauri:build": "cd web && tauri build",
    "setup:logrotate": "pm2 install pm2-logrotate && pm2 set pm2-logrotate:max_size 10M && pm2 set pm2-logrotate:retain 30 && pm2 set pm2-logrotate:compress true && pm2 set pm2-logrotate:dateFormat YYYY-MM-DD_HH-mm-ss && pm2 set pm2-logrotate:workerInterval 30 && pm2 set pm2-logrotate:rotateInterval \"0 * * * *\""
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@casl/prisma": "^1.6.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
