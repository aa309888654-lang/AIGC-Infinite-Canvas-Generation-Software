    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.0",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "pdfkit": "^0.18.0",
    "pixi.js": "^8.17.1",
    "pino": "^10.3.1",
    "pino-loki": "^2.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.53.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "rembg-webgpu": "^0.2.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.11",
    "tone": "^15.1.22",
    "uuid": "^14.0.1",
    "vectra": "^0.9.0",
