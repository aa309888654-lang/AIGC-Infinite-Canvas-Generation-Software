{
  "name": "xiaotian-canvas-backend",
  "version": "2.7.9",
  "displayVersion": "v2.7.9",
  "description": "小天画布后端服务 - 匹配前端所有参数与设定",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --ignore prisma --ignore dist src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'),p='dist/services/promptSmart3/providers.json',s='src/services/promptSmart3/providers.json';if(fs.existsSync(s)){fs.mkdirSync(require('path').dirname(p),{recursive:true});fs.copyFileSync(s,p);console.log('Copied providers.json')}\"",
    "build:prod": "npm run build && node scripts/obfuscate.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "init:providers": "tsx scripts/init-provider-config.ts",
    "init:memberships": "tsx scripts/init-memberships.ts",
    "predeploy": "tsx scripts/predeploy-check.ts",
    "backup:providers": "tsx scripts/backup-providers.ts backup",
    "restore:providers": "tsx scripts/backup-providers.ts restore",
    "list:providers": "tsx scripts/backup-providers.ts list",
    "security:audit": "npm audit --omit=dev --registry=https://registry.npmjs.org/",
    "perf:k6:health": "k6 run load-tests/health-check.js",
    "perf:k6:admin-users": "k6 run load-tests/admin-users.js",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
    "setup:logrotate": "pm2 install pm2-logrotate && pm2 set pm2-logrotate:max_size 10M && pm2 set pm2-logrotate:retain 30 && pm2 set pm2-logrotate:compress true && pm2 set pm2-logrotate:dateFormat YYYY-MM-DD_HH-mm-ss && pm2 set pm2-logrotate:workerInterval 30 && pm2 set pm2-logrotate:rotateInterval \"0 * * * *\""
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/dysmsapi20170525": "^4.5.1",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@casl/ability": "^6.8.0",
    "@casl/prisma": "^1.6.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@imgly/background-removal": "^1.7.0",
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "pino-loki": "^2.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "tencentcloud-sdk-nodejs": "^4.1.203",
    "uuid": "^14.0.1",
    "vectra": "^0.9.0",
    "ws": "^8.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/minio": "^7.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.19",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "prisma": "^5.10.0",
    "ssh2": "^1.17.0",
    "supertest": "^7.1.1",
    "terser": "^5.48.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "axios": "^1.18.1",
    "uuid": "^14.0.1",
    "vectra": {
      "uuid": "^14.0.1"
    },
    "test-exclude": {
      "glob": "10.5.0"
    },
    "onnxruntime-web": {
      "protobufjs": "7.6.3"
    }
  }
}
