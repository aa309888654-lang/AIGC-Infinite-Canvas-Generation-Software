generator client {
  provider = "prisma-client-js"
}

datasource db {
  // P1 修复 #10：Prisma provider 必须为字面量（不支持 env()）。
  // 开发环境使用 sqlite；生产部署时需将此项改为 "postgresql" 并重新 prisma generate。
  // 运行时由 src/types/env.ts 强制校验：生产环境 DATABASE_URL 含 sqlite/file: 时直接 throw，拒绝启动。
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(uuid())
  username                String                    @unique
  email                   String                    @unique
  emailCipher             String?
  emailHash               String?
  password                String
  role                    String                    @default("user")
  apiQuota                Int                       @default(100)
  usedQuota               Int                       @default(0)
  isActive                Boolean                   @default(true)
  phone                   String?                   @unique
  phoneCipher             String?
  phoneHash               String?
  // A one-way hash of the client installation identifier.  It is unique so a
  // browser/app installation cannot create multiple accounts.
  deviceIdHash            String?                   @unique
  avatar                  String?
  lastLoginAt             DateTime?                 @map("last_login_at")
  lastLoginIp             String?                   @map("last_login_ip")
  points                  Int                       @default(0)
  pointsBalance           Float                     @default(0)
  rechargePointsBalance   Float                     @default(0)
  frozenPoints            Float                     @default(0)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  apiCallLogs             ApiCallLog[]
  apiKeys                 ApiKey[]
  campaignParticipations  CampaignParticipation[]
  canvasProjects          CanvasProject[]
  characterLibrary        CharacterLibrary[]
  sceneLibrary            SceneLibrary[]
  propLibrary             PropLibrary[]
  chatConversations       ChatConversation[]
  communityApplications   CommunityApplication[]
  communityComments       CommunityComment[]
  communityPostLikes      CommunityPostLike[]
  communityPosts          CommunityPost[]
  favorites               Favorite[]
  ipPointsGrants          IpPointsGrant[]
  loginLogs               LoginLog[]
  manualRequests          ManualMembershipRequest[]
  membershipOrders        MembershipOrder[]
  notifications           Notification[]
  paymentLogs             PaymentLog[]
  payments                Payment[]
  playHistory             PlayHistory[]
  pointsAlerts            PointsAlert?
  pointsOrders            PointsOrder[]
  pointsTransactions      PointsTransaction[]
  songs                   Song[]
  tasks                   Task[]
  tickets                 Ticket[]
  usageLogs               UsageLog[]
  userApiKeys             UserApiKey[]
  modelCredentialVault    UserModelCredentialVault?
  UserFile                UserFile[]
  userMemberships         UserMembership[]
  notificationSettings    UserNotificationSetting?
  quota                   UserQuota?
  rateLimits              UserRateLimit[]
  registrations           UserRegistration[]
  voiceChatMessages       VoiceChatMessage[]
  posterProjects          PosterProject[]

  @@map("users")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String
  data      String?
  isRead    Boolean   @default(false)
  priority  String    @default("normal")
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type])
  @@map("notifications")
}

model UserNotificationSetting {
  id              String   @id @default(uuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  typesEnabled    String   @default("system,task,payment")
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model UserFile {
  id           String    @id @default(uuid())
  userId       String
  filename     String
  originalName String
  fileType     String
  fileSize     Int
  size         Int?
  mimeType     String
  filePath     String
  storagePath  String?
  url          String?
  cosUrl       String?
  thumbnailUrl String?
  metadata     String?
  folder       String    @default("/")
  isPublic     Boolean   @default(false)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fileType])
  @@index([folder])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("user_files")
}

model CampaignParticipation {
  id         String    @id @default(uuid())
  userId     String
  campaignId String
  status     String    @default("pending")
  prizeWon   String?
  redeemedAt DateTime?
  expiresAt  DateTime?
  metadata   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([campaignId])
  @@map("campaign_participations")
}

model Ticket {
  id         String    @id @default(uuid())
  userId     String
  subject    String
  category   String    @default("general")
  status     String    @default("open")
  priority   String    @default("normal")
  messages   String    @default("[]")
  isPublic   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model UserMembership {
  id           String     @id @default(uuid())
  userId       String
  membershipId String
  level        String     @default("free")
  status       String     @default("active")
  startAt      DateTime?
  endAt        DateTime?
  nextGrantAt  DateTime?
  grantPolicy  String?
  autoRenew    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([membershipId])
  @@index([status])
  @@index([userId, status, endAt]) // CFG-06 修复：添加复合索引优化认证路径高频查询
  @@map("user_memberships")
}

model CharacterLibrary {
  id           String             @id @default(uuid())
  userId       String
  name         String
  description  String             @default("")
  appearance   String             @default("")
  personality  String             @default("")
  outfit       String             @default("")
  traits       String             @default("[]")
  imageUrl     String?
  thumbnailUrl String?
  groupType    String             @default("MAIN")
  isActive     Boolean            @default(true)
  useCount     Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageHistory CharacterUsage[]
  variants     CharacterVariant[]

  @@index([userId])
  @@index([groupType])
  @@index([createdAt])
  @@map("character_library")
}

model CharacterVariant {
  id           String           @id @default(uuid())
  characterId  String
  variantType  String
  variantName  String
  expression   String?
  pose         String?
  outfit       String?
  angle        String?
  imageUrl     String?
  thumbnailUrl String?
  prompt       String           @default("")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  character    CharacterLibrary @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([variantType])
  @@map("character_variants")
}

model CharacterUsage {
  id             String           @id @default(uuid())
  characterId    String
  sceneId        String?
  sceneName      String?
  usageContext   String?
  generatedImage String?
  createdAt      DateTime         @default(now())
  character      CharacterLibrary @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([createdAt])
  @@map("character_usage")
}

model SceneLibrary {
  id                String   @id @default(uuid())
  userId            String
  name              String
  summary           String   @default("")
  primaryImage      String?
  lightingPrompt    String   @default("")
  environmentPrompt String   @default("")
  prompt            String   @default("")
  negativePrompt    String   @default("")
  tags              String   @default("[]")
  isActive          Boolean  @default(true)
  useCount          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("scene_library")
}

model PropLibrary {
  id             String   @id @default(uuid())
  userId         String
  name           String
  summary        String   @default("")
  primaryImage   String?
  materialTags   String   @default("[]")
  prompt         String   @default("")
  negativePrompt String   @default("")
  tags           String   @default("[]")
  isActive       Boolean  @default(true)
  useCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("prop_library")
}

model CharacterTemplate {
  id           String   @id @default(uuid())
  userId       String?
  name         String
  category     String   @default("custom")
  description  String   @default("")
  prompt       String
  thumbnailUrl String?
  isPublic     Boolean  @default(false)
  useCount     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isPublic])
  @@map("character_templates")
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  name      String
  key       String    @unique
  provider  String?
  models    String?
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Task {
  id             String   @id @default(uuid())
  userId         String
  type           String
  prompt         String
  params         String?
  status         String   @default("pending")
  progress       Int      @default(0)
  result         String?
  error          String?
  taskId         String?  @unique
  providerTaskId String?
  model          String?
  provider       String?
  outputUrl      String?
  cosUrl         String?
  thumbnailUrl   String?
  credits        Int      @default(0)
  reviewStatus   String   @default("pending")
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewNote     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([reviewStatus])
  @@index([createdAt])
  @@map("tasks")
}

/// 服务端权威海报项目。浏览器存储仅缓存 project id，不再承载会话事实。
model PosterProject {
  id              String                @id
  userId          String
  name            String                @default("未命名海报")
  status          String                @default("draft")
  textRenderMode  String                @default("native")
  messages        String                @default("[]")
  brief           String?
  compiledPrompt  String?
  referenceImages String                @default("[]")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefVersions   PosterBriefVersion[]
  generationRuns  PosterGenerationRun[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([status])
  @@map("poster_projects")
}

model PosterBriefVersion {
  id        String        @id @default(uuid())
  projectId String
  version   Int
  brief     String
  createdAt DateTime      @default(now())
  project   PosterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@map("poster_brief_versions")
}

model PosterGenerationRun {
  id                 String            @id @default(uuid())
  projectId          String
  idempotencyKey     String            @unique
  status             String            @default("queued")
  model              String            @default("gpt-image-2")
  provider           String?
  textRenderMode     String            @default("native")
  prompt             String
  requestPayload     String?
  templateId         String?
  promptVersion      String            @default("gpt-image-2-native-text-v1")
  layoutRuleVersion  String            @default("poster-layout-v1")
  qualityRuleVersion String            @default("poster-three-gates-v1")
  refinementVersion  String            @default("gpt-image-2-native-refine-v1")
  providerTaskId     String?
  error              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  project            PosterProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidates         PosterCandidate[]

  @@index([projectId, createdAt])
  @@index([status])
  @@index([templateId])
  @@map("poster_generation_runs")
}

model PosterCandidate {
  id              String                @id @default(uuid())
  generationRunId String
  imageUrl        String
  status          String                @default("generated")
  rank            Int?
  qualityStatus   String?
  createdAt       DateTime              @default(now())
  generationRun   PosterGenerationRun   @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
  qualityReports  PosterQualityReport[]

  @@index([generationRunId, rank])
  @@map("poster_candidates")
}

model PosterQualityReport {
  id          String          @id @default(uuid())
  candidateId String
  status      String          @default("completed")
  engine      String?
  report      String
  degraded    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  candidate   PosterCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([degraded])
  @@map("poster_quality_reports")
}

model PaymentLog {
  id            String    @id @default(uuid())
  userId        String
  type          String
  amount        Float
  currency      String    @default("CNY")
  status        String    @default("pending")
  method        String?
  orderNo       String?   @unique
  transactionId String?
  metadata      String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_logs")
}

model Payment {
  id            String    @id @default(uuid())
  userId        String
  membershipId  String
  orderNo       String    @unique
  amount        Float
  currency      String    @default("CNY")
  status        String    @default("pending")
  paymentMethod String?
  channel       String?
  transactionId String?
  tradeNo       String?
  qrCodeImage   String?
  refundAmount  Float?
  refundStatus  String?
  refundNo      String?
  refundReason  String?
  refundedAt    DateTime?
  refundedBy    String?
  paidAt        DateTime?
  expiredAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([refundStatus])
  @@map("payments")
}

model ManualMembershipRequest {
  id           String    @id @default(uuid())
  userId       String
  membershipId String
  duration     String    @default("monthly")
  amount       Float
  status       String    @default("pending")
  paymentProof String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("manual_membership_requests")
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String?
  ip        String?
  userAgent String?
  device    String?
  location  String?
  status    String   @default("success")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_logs")
}

model UsageLog {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  method    String
  params    String?
  status    Int
  duration  Int?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_logs")
}

model UserQuota {
  id              String   @id @default(uuid())
  userId          String   @unique
  dailyLimit      Int      @default(100)
  dailyUsed       Int      @default(0)
  monthlyLimit    Int      @default(1000)
  monthlyUsed     Int      @default(0)
  concurrentLimit Int      @default(3)
  concurrentUsed  Int      @default(0)
  storageLimit    BigInt?
  fileLimit       Int?
  apiCallsLimit   Int?
  resetAt         DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quotas")
}

model MembershipOrder {
  id           String    @id @default(uuid())
  userId       String
  orderNo      String    @unique
  membershipId String
  duration     String    @default("monthly")
  amount       Float
  status       String    @default("pending")
  paymentProof String?
  paidAt       DateTime?
  expiresAt    DateTime?
  refundAmount Float     @default(0)
  refundStatus String?
  refundNo     String?
  refundReason String?
  refundedAt   DateTime?
  refundedBy   String?
  metadata     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([refundStatus])
  @@map("membership_orders")
}

model ProcessedPaymentCallback {
  id          String   @id @default(uuid())
  outTradeNo  String   @unique
  tradeNo     String?
  totalFee    Float
  processedAt DateTime @default(now())
  status      String   @default("success")
  error       String?
  metadata    String?

  @@index([processedAt])
  @@map("processed_payment_callbacks")
}

model Membership {
  id                String           @id @default(uuid())
  name              String           @unique
  displayName       String?
  description       String?
  price             Float
  monthlyPrice      Float?
  quarterlyPrice    Float?
  yearlyPrice       Float?
  duration          String           @default("monthly")
  quota             Int              @default(0)
  monthlyGiftPoints Int              @default(0)
  features          String           @default("[]")
  limits            String?
  grantPolicy       String?
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  userMemberships   UserMembership[]

  @@map("memberships")
}

model ProviderConfig {
  id          String           @id @default(uuid())
  provider    String           @unique
  name        String
  displayName String?
  description String?
  endpoint    String?
  apiKey      String?
  apiSecret   String?
  isActive    Boolean          @default(false)
  config      String           @default("{}")
  priority    Int              @default(0)
  rateLimit   Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  apiKeys     ProviderApiKey[]

  @@map("provider_configs")
}

model ProviderApiKey {
  id             String         @id @default(uuid())
  providerName   String
  keyLabel       String
  encryptedKey   String
  modelScope     String?
  weight         Int            @default(1)
  maxConcurrency Int            @default(1)
  quotaTotal     Int            @default(0)
  quotaUsed      Int            @default(0)
  quotaRemaining Int            @default(0)
  isActive       Boolean        @default(true)
  isExhausted    Boolean        @default(false)
  failureCount   Int            @default(0)
  lastFailureAt  DateTime?
  disabledAt     DateTime?
  priority       Int            @default(0)
  lastUsedAt     DateTime?
  exhaustedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  provider       ProviderConfig @relation(fields: [providerName], references: [provider], onDelete: Cascade)

  @@unique([providerName, keyLabel])
  @@index([providerName, isActive, isExhausted])
  @@map("provider_api_keys")
}

model UserRegistration {
  id                 String    @id @default(uuid())
  userId             String
  username           String
  email              String
  phone              String?
  passwordHash       String
  status             String    @default("pending")
  registrationMethod String    @default("email")
  referralCode       String?
  metadata           String?
  approvalAdminId    String?
  approvalNote       String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_registrations")
}

model IpPointsGrant {
  id        String    @id @default(uuid())
  userId    String?
  ip        String
  points    Int
  reason    String?
  adminId   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ip])
  @@index([createdAt])
  @@map("ip_points_grants")
}

model UserRateLimit {
  id              String   @id @default(uuid())
  userId          String
  endpoint        String?
  limitType       String   @default("fixed")
  limit           Int
  window          Int      @default(60)
  dailyLimit      Int      @default(1000)
  dailyUsed       Int      @default(0)
  monthlyLimit    Int      @default(10000)
  monthlyUsed     Int      @default(0)
  minuteLimit     Int      @default(60)
  secondLimit     Int      @default(10)
  concurrentLimit Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_rate_limits")
}

model PointsAlert {
  id          String    @id @default(uuid())
  userId      String    @unique
  threshold   Int       @default(100)
  isEnabled   Boolean   @default(true)
  lastAlertAt DateTime?
  alertCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_alerts")
}

model FrontendSession {
  id             String    @id @default(uuid())
  sessionId      String    @unique
  userId         String?
  userAgent      String
  screenWidth    Int?
  screenHeight   Int?
  viewportWidth  Int?
  viewportHeight Int?
  deviceType     String?
  browserName    String?
  browserVersion String?
  osName         String?
  osVersion      String?
  language       String?
  timezone       String?
  ipAddress      String?
  country        String?
  city           String?
  startTime      DateTime  @default(now())
  endTime        DateTime?
  duration       Int?
  pageCount      Int       @default(0)
  eventCount     Int       @default(0)
  errorCount     Int       @default(0)
  isBounce       Boolean?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sessionId])
  @@index([userId])
  @@index([startTime])
  @@map("frontend_sessions")
}

model FrontendPageView {
  id             String   @id @default(uuid())
  sessionId      String
  pageUrl        String
  pageTitle      String?
  referrer       String?
  viewportWidth  Int?
  viewportHeight Int?
  scrollDepth    Int?
  timeOnPage     Int?
  timestamp      DateTime @default(now())

  @@index([sessionId])
  @@index([pageUrl])
  @@index([timestamp])
  @@map("frontend_page_views")
}

model FrontendEvent {
  id        String   @id @default(uuid())
  sessionId String
  category  String
  action    String
  label     String?
  value     String?
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([category])
  @@index([timestamp])
  @@map("frontend_events")
}

model Song {
  id            String        @id @default(uuid())
  userId        String
  title         String
  artist        String?
  composer      String?
  lyricist      String?
  arranger      String?
  producer      String?
  album         String?
  genre         String?
  year          String?
  comment       String?
  lyrics        String?
  lrc           String?
  audioUrl      String
  coverImageUrl String?
  duration      Int?
  model         String?
  provider      String?
  isPublic      Boolean       @default(false)
  playCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  favorites     Favorite[]
  playHistory   PlayHistory[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([title])
  @@index([genre])
  @@index([createdAt])
  @@map("songs")
}

model Favorite {
