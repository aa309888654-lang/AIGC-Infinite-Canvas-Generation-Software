  @@index([sessionId])
  @@index([errorType])
  @@index([timestamp])
  @@map("frontend_errors")
}

model DailyUsage {
  id                      String   @id @default(uuid())
  userId                  String
  date                    String
  musicCount              Int      @default(0)
  imageCount              Int      @default(0)
  audioMinutes            Float    @default(0)
  promptOptimizationCount Int      @default(0)
  videoCount              Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_usage")
}

model ApiCallLog {
  id           String     @id @default(uuid())
  userApiKeyId String
  userId       String
  provider     String
  model        String?
  endpoint     String
  method       String
  inputTokens  Int?
  outputTokens Int?
  inputCost    Float      @default(0)
  outputCost   Float      @default(0)
  totalCost    Float      @default(0)
  pointsCost   Int        @default(0)
  latencyMs    Int?
  statusCode   Int?
  requestId    String?
  errorMessage String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  userApiKey   UserApiKey @relation(fields: [userApiKeyId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userApiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@index([createdAt])
  @@map("api_call_logs")
}

model UserApiKey {
  id              String       @id @default(uuid())
  userId          String
  keyName         String
  apiKey          String       @unique
  apiSecret       String?
  provider        String?
  models          String?
  permissions     String?
  isActive        Boolean      @default(true)
  isPrimary       Boolean      @default(false)
  rateLimit       Int          @default(60)
  rateLimitWindow String       @default("minute")
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  totalCalls      Int          @default(0)
  totalCost       Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  callLogs        ApiCallLog[]
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("user_api_keys")
}

/// 用户自带模型凭据：整份内容使用服务器 AES-256-GCM 加密，绝不向浏览器回传明文。
/// 限额由路由按解密前 JSON 字节数强制为 2MB。
model UserModelCredentialVault {
  id               String   @id @default(uuid())
  userId           String   @unique
  encryptedPayload String
  payloadBytes     Int      @default(0)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_model_credential_vaults")
}

