model SiteMessage {
  id          String            @id @default(uuid())
  title       String
  content     String
  type        String            @default("system")
  priority    String            @default("normal")
  audience    String            @default("all")
  showInLogin Boolean           @default(true) @map("show_in_login")
  autoPopup   Boolean           @default(false) @map("auto_popup")
  isActive    Boolean           @default(true) @map("is_active")
  sortOrder   Int               @default(0) @map("sort_order")
  linkUrl     String?           @map("link_url")
  linkLabel   String?           @map("link_label")
  startsAt    DateTime?         @map("starts_at")
  endsAt      DateTime?         @map("ends_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  reads       SiteMessageRead[]

  @@index([isActive, sortOrder])
  @@index([audience])
  @@map("site_messages")
}

model SiteMessageRead {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  messageId String      @map("message_id")
  readAt    DateTime    @default(now()) @map("read_at")
  message   SiteMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
  @@map("site_message_reads")
}

model PromptLog {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  prompt          String
  negativePrompt  String   @default("") @map("negative_prompt")
  model           String?
  provider        String?
  type            String   @default("image")
  source          String   @default("ai-view")
  optimizedPrompt String?  @map("optimized_prompt")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  metadata        String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([source])
  @@index([createdAt])
  @@map("prompt_logs")
}
