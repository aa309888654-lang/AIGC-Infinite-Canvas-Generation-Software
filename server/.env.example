# 后端环境变量模板（勿提交真实值）
# 复制为 server/.env 后填入真实密钥

# === 本地服务 ===
PORT=3200
BASE_URL=http://localhost:3200
BACKEND_URL=http://127.0.0.1:3200

# === 前端构建产物路径 ===
# 生产环境可指向 nginx 静态根目录或留空使用 ../web/dist
FRONTEND_DIST_PATH=

# === 数据库（本地开发使用 SQLite；生产可用 PostgreSQL/MySQL）===
DATABASE_URL=file:./dev.db

# === 对象存储（可选）===
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=aicg-files
MINIO_PUBLIC_URL=
MINIO_ALLOW_PUBLIC_POLICY=false
MINIO_MAX_GET_FILE_BYTES=20971520

# === 大模型服务商（填写你想启用的服务商密钥，留空则禁用）===
# SenseNova（提示词优化 + U1 Fast 生图）
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=

# StepFun（step-image-edit-2 海报生图 + 语音）
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_API_KEY=

# Agnes AI（Agnes-Video-V2.0 + Agnes Image 2.1 Flash）
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=

# 豆包 / Seedream
DOUBAO_IMAGE_KEY=
ARK_API_KEY=

# DeepSeek（文本模型）
DEEPSEEK_API_KEY=

# NVIDIA NIM（DeepSeek V4 Pro 等）
NVIDIA_NIM_API_KEY=

# 智谱 GLM（文本模型）
ZHIPU_API_KEY=

# MiniMax（音乐生成 / 海螺视频）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com

# 小天 GPT-Image
WUYIN_API_KEY=

# 自定义 OpenAI 兼容端点（可选）
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=

# === 加密（本地开发可留空；生产建议强随机值 openssl rand -hex 32）===
JWT_SECRET=
ENCRYPTION_KEY=

# === 错误追踪（可选）===
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1


# === 本地 Python Sidecar 服务（可选）===
SAM2_SERVER_URL=http://127.0.0.1:7100
SAM2_ENABLED=true
REAL_ESRGAN_SERVER_URL=http://127.0.0.1:7300
REAL_ESRGAN_ENABLED=true
